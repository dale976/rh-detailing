{
  "name": "rh-detailing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build && npm run test:seo",
    "build:review": "node scripts/build-review.mjs",
    "test:seo": "CHECK_SEO_BUILD=production node --test tests/seo-build.test.js",
    "refresh:instagram": "node scripts/refresh-instagram.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "3.6.2",
    "vite": "8.0.16"
  }
}
